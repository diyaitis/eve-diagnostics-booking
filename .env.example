# Copy to .env for local (non-Docker) runs. Docker Compose sets its own values.
DATABASE_URL=postgresql+psycopg://eve:eve@localhost:5433/eve

# Generate real values, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-use-a-random-32-byte-value
WEBHOOK_SECRET=dev-webhook-secret

# Optional. Enables the catalogue cache and background jobs (run: celery -A app.worker worker --beat).
# Without it the API works from the database alone and skips notifications.
# REDIS_URL=redis://localhost:6380/0
CATALOGUE_CACHE_TTL_SECONDS=300
UNPAID_BOOKING_EXPIRY_HOURS=24

ACCESS_TOKEN_EXPIRE_MINUTES=60
PAYMENT_SUCCESS_RATE=0.8
ALLOW_SIMULATED_OUTCOME=true
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json   # or: text
